# Settings for the run loop. setup_box.sh copies this to ~/.awe/<repo>/config.env, outside the repo.
# Edit that copy. Nothing here is required, and the defaults are shown.

# ---- notifications -------------------------------------------------------------------------
# Phone pushes through ntfy. Install the ntfy app, subscribe to a topic name that is hard to guess,
# and put the same name here. Anyone who knows the name can read the messages.
AWE_NTFY_TOPIC=
# Or a Slack incoming webhook URL.
AWE_SLACK_WEBHOOK=
# A ping URL from a service such as healthchecks.io. The loop pings it on every pass, and the
# service alerts you when the pings stop. This is the only alarm that fires if the box itself dies.
AWE_HEALTHCHECK_URL=

# ---- models and effort ---------------------------------------------------------------------
# Model for agent sessions. Empty means your account default.
AWE_MODEL=opus
# Optional stronger model for the two stages that decide the result, diagnosis (1) and edit design (3).
# In unattended runs, Fable requests beyond your plan's Fable allowance are billed to usage
# credits without asking. Set a monthly spend limit in claude.ai before you put fable here.
AWE_MODEL_DESIGN=
# Model for the reviewer sessions. Empty means the same as AWE_MODEL.
AWE_REVIEW_MODEL=
# How hard each session thinks. Levels are low, medium, high, xhigh and max. Empty means the
# model's default, which is medium on Opus 5.5. Higher levels think longer and use more of your
# weekly limit. The loop refuses a level it does not know, because Claude Code would quietly
# ignore it and run at the default. A model without xhigh runs it as high.
# Every session outside stages 1 and 3.
AWE_EFFORT=high
# Stage 1 (diagnosis) and stage 3 (edit design).
AWE_EFFORT_DESIGN=xhigh
# The reviewer sessions that try to refute the diagnosis and the freeze package.
AWE_REVIEW_EFFORT=xhigh
# Turns per session before the loop starts a fresh one. Empty means no cap.
AWE_MAX_TURNS=400
AWE_SESSION_HOURS=6

# ---- scope and limits ----------------------------------------------------------------------
# full runs transfer cube, then the insertion replicate. main stops after the first task.
AWE_SCOPE=full
AWE_MAX_SESSIONS=400
AWE_MAX_DAYS=21
# Sessions in a row that change nothing before the loop stops and asks for you.
AWE_STALL_SESSIONS=4
# Sessions in a row that fail to run, not counting usage limits, before the loop stops and asks for you.
AWE_FAIL_SESSIONS=24
# Seconds to sleep after hitting a usage limit before trying again.
AWE_LIMIT_SLEEP=1800

# ---- the public commitment -----------------------------------------------------------------
# The freeze must be public before the test seeds are drawn. By default the commitment is a
# GitHub release in this repo, so this repo must be public. To keep the work private until you
# publish, create a small public repo and name it here as owner/name. Only hashes go there.
AWE_WITNESS_REPO=

# ---- compute -------------------------------------------------------------------------------
MUJOCO_GL=egl
# Parallel rollout workers. Empty means one per CPU core.
AWE_WORKERS=
# Hours the referee may spend re-running the two main arms with LeRobot's own evaluator.
AWE_STOCK_BUDGET_HOURS=6
# Set to 1 to power the box off five minutes after the run ends or stops for you.
AWE_SHUTDOWN_ON_EXIT=
