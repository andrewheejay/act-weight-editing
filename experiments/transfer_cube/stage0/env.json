{
 "lerobot": "0.7.0",
 "gym_aloha": "0.1.5",
 "mujoco": "3.8.1",
 "torch": "2.15.0",
 "dm_control": "1.0.41",
 "gymnasium": "1.4.0",
 "python": "3.12.16",
 "gpu": "NVIDIA L4, 595.112.07",
 "os": "Linux-6.8.0-1069-aws-x86_64-with-glibc2.35",
 "renderer": "egl_mesa (llvmpipe, Mesa 23.2.1 LLVM 15.0.7)",
 "rollouts_per_second": 7.5,
 "stock_seconds_per_episode": 30.19971616220474,
 "stock_eval_cmd": [
  "env",
  "MUJOCO_GL=egl",
  "PYOPENGL_PLATFORM=egl",
  "__EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json",
  "LIBGL_ALWAYS_SOFTWARE=1",
  "LP_NUM_THREADS=8",
  "lerobot-eval",
  "--policy.path={policy_path}",
  "--env.type=aloha",
  "--env.task={env_task}",
  "--eval.n_episodes={n_episodes}",
  "--eval.batch_size=1",
  "--policy.device=cuda",
  "--policy.use_amp=false",
  "--tf32=false",
  "--seed={seed}",
  "--output_dir={output_dir}"
 ]
}